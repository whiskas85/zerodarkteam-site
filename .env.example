# Dove sta il gestionale, visto dal contenitore del sito. Sulla stessa
# macchina e' il nome del servizio nella rete di Docker.
OPS_URL=http://app:3000

# La chiave del sito, generata in OPS da Contatti -> «Collega un sito».
# Va solo qui, sul server: mai nel repository, mai in una pagina.
CHIAVE_OPS=

# La rete di Docker del gestionale, a cui il sito si aggancia.
RETE_OPS=gestionale_default
